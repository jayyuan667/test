# Copy this file to .env and replace all placeholder values.

# Vision model (OpenAI-compatible)
VISION_API_KEY="your_vision_api_key_here"
VISION_API_BASE="https://ark.cn-beijing.volces.com/api/v3"
VISION_MODEL_ID="doubao-seed-2-0-mini-260215"

# Embedding model
EMBEDDING_API_KEY="your_embedding_api_key_here"
EMBEDDING_BASE_URL="https://ark.cn-beijing.volces.com/api/v3/embeddings/multimodal"
EMBEDDING_MODEL="doubao-embedding-vision-251215"

# Process-generation LLM
LLM_PROVIDER=deepseek
LLM_API_KEY="your_llm_api_key_here"
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_MODEL="deepseek-chat"

# Compatibility aliases used by existing backend modules
DOUBAO_API_KEY="your_vision_api_key_here"
DOUBAO_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
DOUBAO_MODEL="doubao-seed-2-0-mini-260215"

OPENAI_API_KEY="your_llm_api_key_here"
OPENAI_BASE_URL="https://api.deepseek.com/v1"
OPENAI_MODEL="deepseek-chat"

# Optional OnShape PRT conversion
onshape_credentials="your_onshape_base64_credentials_here"
onshape_did="your_onshape_document_id"
onshape_wid="your_onshape_workspace_id"

# Runtime defaults
DEVICE=cpu
VECTOR_DIM=768
TOP_K=3
CORS_ORIGINS="https://gongyi.neusym.cn,http://gongyi.neusym.cn"
JWT_SECRET_KEY="replace_with_a_long_random_secret"

# Demo-only: reuse the previous report for the same ZIP package hash.
# Keep disabled for normal deployment.
DEMO_FAST_ZIP_IMPORT=0

# Optional Windows integrations
# FREECAD_LIB=D:\Program Files\FreeCAD 1.1\lib
# FREECAD_BIN=D:\Program Files\FreeCAD 1.1\bin
# POPPLER_PATH=D:\tools\poppler\Library\bin
