# Copy to deploy/docker/.env.docker on the target server.
# Keep real secrets out of Docker images.

FLASK_DEBUG=0
CORS_ORIGINS=http://gongyis.neusym.cn:5190,http://127.0.0.1:5190,http://127.0.0.1:5191
JWT_SECRET_KEY=replace-with-a-long-random-secret

VISION_MODE=doubao
VISION_API_KEY=
VISION_API_BASE=
VISION_MODEL_ID=

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_TRUST_ENV=1

YOLO_SERVICE_TOKEN=replace-with-the-same-token-for-app-and-yolo
YOLO_SERVICE_TIMEOUT=15
YOLO_CONF=0.25
YOLO_IOU=0.45
YOLO_IMG_SIZE=1280
YOLO_DEVICE=cpu

ZIP_IMPORT_GLOBAL_MAX_RUNNING=2
ZIP_IMPORT_MAX_WORKERS=2
ZIP_IMPORT_PARSE_WORKERS=2
PROCESS_SPEC_MAX_IMAGE_PIXELS=34000000
PROCESS_SPEC_MAX_IMAGE_BYTES=9500000
