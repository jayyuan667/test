        assert reloaded["cache_key"] == "final-cache-key"


class TestRollbackSnapshots:
    def test_save_restore_and_delete_snapshots(self, monkeypatch, tmp_path):
        from backend import workflow_harness

        db_path = str(tmp_path / "vectors.db")
        monkeypatch.setattr(workflow_harness, "DB_PATH", db_path)

        # Create a vector table so we can restore into it
        conn = sqlite3.connect(db_path)
        try:
            conn.execute(
                """
                CREATE TABLE vectors_test_snap (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    prefix TEXT NOT NULL UNIQUE,
                    enterprise_id INTEGER,
                    real INTEGER DEFAULT 1,
                    workflow_run_id TEXT DEFAULT '',
                    source_text TEXT DEFAULT '',
                    vector_content TEXT DEFAULT ''
                )
                """
            )
            conn.execute(
                "INSERT INTO vectors_test_snap (prefix, enterprise_id, real, workflow_run_id, source_text, vector_content) "
                "VALUES (?, ?, ?, ?, ?, ?)",
                ("Y1", 6, 1, "wf_old_run", "old source text", "old vector"),
            )
            conn.commit()
        finally:
            conn.close()

        existing = {
            "prefix": "Y1",
            "enterprise_id": 6,
            "real": 1,
            "workflow_run_id": "wf_old_run",
            "source_text": "old source text",
            "vector_content": "old vector",
        }

        # Save the snapshot
        workflow_harness.save_rollback_snapshot(
            "wf_current", "vectors_test_snap", "Y1", existing
        )

        # Overwrite with new record (simulating INSERT OR REPLACE)
        conn = sqlite3.connect(db_path)
        try:
            conn.execute(
                "INSERT OR REPLACE INTO vectors_test_snap (prefix, enterprise_id, real, workflow_run_id, source_text, vector_content) "
                "VALUES (?, ?, ?, ?, ?, ?)",
                ("Y1", 6, 1, "wf_current", "new source text", "new vector"),
            )
            conn.commit()
        finally:
            conn.close()

        # Restore snapshots
        restored = workflow_harness.restore_rollback_snapshots("wf_current")
        assert restored == 1

        # Delete current run's rows
        conn = sqlite3.connect(db_path)
        try:
            conn.execute("DELETE FROM vectors_test_snap WHERE workflow_run_id = ?", ("wf_current",))
            conn.commit()
            row = conn.execute(
                "SELECT prefix, source_text, workflow_run_id FROM vectors_test_snap WHERE prefix = ?",
                ("Y1",),
            ).fetchone()
        finally:
            conn.close()

        # Old record is restored
        assert row is not None
        assert row[0] == "Y1"
        assert row[1] == "old source text"

        # Cleanup snapshots
        deleted = workflow_harness.delete_rollback_snapshots("wf_current")
        assert deleted == 1

        # Verify snapshots are gone
        conn = sqlite3.connect(db_path)
        try:
            remaining = conn.execute(
                "SELECT COUNT(*) FROM workflow_rollback_snapshots WHERE workflow_run_id = ?",
                ("wf_current",),
            ).fetchone()[0]
        finally:
            conn.close()
        assert remaining == 0

