class TestWorkflowRunLifecycle:
    def test_workflow_run_lifecycle(self, monkeypatch, tmp_path):
        from backend import workflow_harness

        db_path = str(tmp_path / "vectors.db")
        monkeypatch.setattr(workflow_harness, "DB_PATH", db_path)

        run = workflow_harness.create_workflow_run(
            workflow_type="zip_import",
            enterprise_id=6,
            user_id=12,
            library_key="vectors_my_db",
            batch_id="kb_test",
            input_hash="abc",
            cache_key="cache-abc",
        )

        workflow_harness.record_workflow_event(
            run["run_id"],
            "received",
            "ZIP received",
            progress_hint=5,
            payload={"zip_name": "demo.zip"},
        )
        finished = workflow_harness.finish_workflow_run(
            run["run_id"],
            "completed",
            result={"batch_id": "kb_test", "validation": {"status": "passed"}},
        )

        loaded = workflow_harness.get_workflow_run(run["run_id"], include_events=True)

        assert run["run_id"].startswith("wf_zip_import_")
        assert finished["status"] == "completed"
        assert loaded["workflow_type"] == "zip_import"
        assert loaded["enterprise_id"] == 6
        assert loaded["library_key"] == "vectors_my_db"
        assert loaded["result"]["validation"]["status"] == "passed"
        assert loaded["events"][0]["stage"] == "received"
        assert loaded["events"][0]["payload"]["zip_name"] == "demo.zip"

    def test_finish_workflow_run_records_failure(self, monkeypatch, tmp_path):
        from backend import workflow_harness

        db_path = str(tmp_path / "vectors.db")
        monkeypatch.setattr(workflow_harness, "DB_PATH", db_path)

        run = workflow_harness.create_workflow_run(
            workflow_type="zip_import",
            enterprise_id=None,
            user_id=1,
        )
        workflow_harness.finish_workflow_run(
            run["run_id"],
            "failed",
            error_code="visibility_mismatch",
            error_message="visible count mismatch",
        )

        conn = sqlite3.connect(db_path)
        try:
            row = conn.execute(
                "SELECT status, error_code, error_message FROM workflow_runs WHERE run_id = ?",
                (run["run_id"],),
            ).fetchone()
        finally:
            conn.close()

        assert row == ("failed", "visibility_mismatch", "visible count mismatch")


class TestUpdateWorkflowMetadata:
    def test_update_cache_key_after_scope_resolution(self, monkeypatch, tmp_path):
        from backend import workflow_harness

        db_path = str(tmp_path / "vectors.db")
        monkeypatch.setattr(workflow_harness, "DB_PATH", db_path)

        run = workflow_harness.create_workflow_run(
            "zip_import",
            enterprise_id=6,
            user_id=1,
            library_key="",
            cache_key="provisional-key",
        )

        updated = workflow_harness.update_workflow_metadata(
            run["run_id"],
            library_key="vectors_final_lib",
