    def test_snapshot_existing_record_restores_vector_and_content(self, monkeypatch, tmp_path):
        from backend import workflow_harness

        db_path = str(tmp_path / "vectors.db")
        monkeypatch.setattr(workflow_harness, "DB_PATH", db_path)

        conn = sqlite3.connect(db_path)
        try:
            conn.execute(
                """
                CREATE TABLE vectors_raw_snap (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    prefix TEXT NOT NULL,
                    vector BLOB,
                    content TEXT,
                    context TEXT,
                    enterprise_id INTEGER,
                    workflow_run_id TEXT DEFAULT '',
                    real INTEGER DEFAULT 1
                )
                """
            )
            conn.execute(
                """
                CREATE UNIQUE INDEX idx_vectors_raw_snap_prefix_real_unique
                ON vectors_raw_snap(prefix)
                WHERE COALESCE(real, 1) = 1
                """
            )
            conn.execute(
                "INSERT INTO vectors_raw_snap (prefix, vector, content, context, enterprise_id, workflow_run_id, real) "
                "VALUES (?, ?, ?, ?, ?, ?, ?)",
                ("Y1", b"old-vector", '["0010@车@旧"]', "old context", 6, "wf_old", 1),
            )
            conn.commit()
        finally:
            conn.close()

        saved = workflow_harness.snapshot_existing_record("wf_current", "vectors_raw_snap", "Y1")
        assert saved is True

        conn = sqlite3.connect(db_path)
        try:
            conn.execute(
                "INSERT OR REPLACE INTO vectors_raw_snap (prefix, vector, content, context, enterprise_id, workflow_run_id, real) "
                "VALUES (?, ?, ?, ?, ?, ?, ?)",
                ("Y1", b"new-vector", '["0010@车@新"]', "new context", 6, "wf_current", 1),
            )
            conn.commit()
        finally:
            conn.close()

        restored = workflow_harness.restore_rollback_snapshots("wf_current")
        assert restored == 1

        conn = sqlite3.connect(db_path)
        try:
            row = conn.execute(
                "SELECT prefix, vector, content, context, enterprise_id, workflow_run_id, real "
                "FROM vectors_raw_snap WHERE prefix = ?",
                ("Y1",),
            ).fetchone()
        finally:
            conn.close()

        assert row == (
            "Y1",
            b"old-vector",
            '["0010@车@旧"]',
            "old context",
            6,
            "wf_old",
            1,
        )
