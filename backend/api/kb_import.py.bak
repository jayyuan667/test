THUMB_SIZE = (200, 200)


def _generate_thumbnail(src_path: str, dst_path: str, size: tuple = THUMB_SIZE) -> bool:
    """生成缩略图，失败返回 False"""
    try:
        with Image.open(src_path) as img:
            img.thumbnail(size, Image.Resampling.LANCZOS)
            if img.mode not in ("RGB", "RGBA"):
                img = img.convert("RGB")
            img.save(dst_path, format="PNG", optimize=True)
        return True
    except Exception:
        return False


